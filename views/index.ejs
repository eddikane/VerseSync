<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Sets the character encoding so normal text and special characters display correctly -->
    <meta charset="UTF-8">

    <!-- Makes the page scale correctly on different screen sizes -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Text displayed in the browser tab -->
    <title>VerseSync</title>


    <!-- =====================================================
         GOOGLE FONTS
         ===================================================== -->

    <!--
    Preconnect helps the browser connect to Google's font servers
    a little earlier so the fonts can load faster.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!--
    Loads the two fonts used throughout VerseSync:
    - Google Sans for general text
    - Playfair Display for headings
    -->
    <link
        href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet"
    >


    <!-- Loads the site's custom CSS after the Google Fonts -->
    <link rel="stylesheet" href="style.css">
</head>


<body>

    <!--
    appName comes from server.js.

    <%= ... %> is EJS syntax used to display a value
    inside the generated HTML.
    -->
    <header>
        <h1><%= appName %></h1>
    </header>


    <main>

        <!-- =====================================================
             CURRENT STUDY WEEK
             ===================================================== -->

        <!--
        currentWeek is selected in server.js based on the
        week number in the URL.
        -->
        <section id="this-week">

            <h2>This Week</h2>

            <!-- Display the dates and scripture reading for the selected week -->
            <p>
                <strong id="date"><%= currentWeek.dates %>: 
                <%= currentWeek.scripture %></strong>
            </p>


            <!-- Opens the official Come, Follow Me page in another tab -->
            <a
                class="primary-button"
                id="scripture-link"
                href="https://www.churchofjesuschrist.org/study/manual/come-follow-me-for-home-and-church-old-testament-2026"
                target="_blank"
            >
                Come, Follow Me
            </a>


            <!-- =================================================
                 WEEK NAVIGATION
                 ================================================= -->

            <nav class="week-navigation">

                <!--
                Only show Previous Week if the user is not
                already viewing the first week.
                -->
                <% if (currentWeek.weekNumber > 1) { %>

                    <!--
                    The week number is added to the URL as a query parameter.
                    Example: /?week=2
                    -->
                    <a class="primary-button" href="/?week=<%= weekNumber - 1 %>">
                        Previous Week
                    </a>

                <% } %>
                    

                <!--
                Only show Next Week when another week exists.
                -->
                <% if (weekNumber < totalWeeks) { %>

                    <a class="primary-button" href="/?week=<%= weekNumber + 1 %>">
                        Next Week
                    </a>

                <% } %>

            </nav>

        </section>


        <!-- =====================================================
             SHARED INSIGHTS LINK
             ===================================================== -->

        <!-- Links the home page to the second dynamic page -->
        <section id="share-insight">

            <h2>Share An Insight</h2>

            <p>
                Share your scripture insights and read what others have contributed.
            </p>

            <!-- Express handles this URL using the GET /insights route -->
            <a class="primary-button" href="/insights">
                Insights
            </a>

        </section>

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer>

        <p><strong>VerseSync</strong> — Study. Share. Grow.</p>

        <!-- Navigation between the two main pages -->
        <nav>
            <a class="primary-button" href="/">Home</a>
            <a class="primary-button" href="/insights">Shared Insights</a>
        </nav>

        <p>&copy; 2026 Edward Kane</p>

    </footer>

</body>

</html>